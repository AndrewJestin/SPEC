{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/outputs/spec-smart-property-exterior-care/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/outputs/spec-smart-property-exterior-care/styles.css"
    },
    {
